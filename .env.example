# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml (production) — see README for local development.

# --- Public URL (used in email links) ---
APP_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
# Public hostname used by the NGINX config (server_name and certificate paths).
DOMAIN=localhost
# nginx.conf = plain HTTP. Switch to https.conf after issuing certificates (README "HTTPS").
NGINX_CONF=nginx.conf

# --- PostgreSQL ---
POSTGRES_USER=uptimehq
POSTGRES_DB=uptimehq
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Clerk (sign-in / sign-up). See README "Clerk setup". ---
# Dashboard > Configure > API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Dashboard > Configure > API keys > "JWT public key" (PEM). Put it on ONE line, replacing
# each line break with the two characters \n, inside double quotes.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"
# Origins allowed to use sessions (comma-separated, no trailing slash). Must match the URL in the browser.
CLERK_AUTHORIZED_PARTIES=http://localhost

# --- Credentials for authenticated monitors ---
# 32-byte AES-256-GCM key, as 64 hex characters (or base64 of 32 bytes).
# Generate with:  openssl rand -hex 32
#   or:           node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Only needed if monitors use authentication. Keep it secret and back it up:
# losing it makes stored monitor credentials unreadable (re-enter them to recover).
MONITOR_CREDENTIAL_ENCRYPTION_KEY=

# --- Monitoring ---
WORKER_CONCURRENCY=10
SCHEDULER_RECONCILE_SECONDS=60
CHECK_RETENTION_DAYS=30

# --- SMTP (optional). Leave SMTP_HOST empty to disable email alerts. ---
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS when offered
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="UptimeHQ <alerts@example.com>"
